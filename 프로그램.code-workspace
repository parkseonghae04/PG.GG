    </section>

    <footer>© 2026 SENS.LAB · 배그 감도 추천 계산기 (비공식 팬 도구)</footer>

    <script>
        const $ = id => document.getElementById(id);

        /* =========================================================
           1) 이벤트 데이터  ← 새 이벤트는 여기에 한 줄만 추가하세요
