        }, {
            id: 'store',
            type: 'store',
            title: '11월 상점 업데이트',
            desc: 'IVE 콜라보 아이템과 새 프로그레시브 무기 스킨이 상점에 올라왔어요.',
            start: '2026-11-04T17:30:00+09:00',
            end: '2027-04-07T09:00:00+09:00'
        }, {
            id: 'pgcpass',
            type: 'pass',
            title: '이벤트 패스 : PGC 2026',
            desc: '곧 열리는 PGC 2026을 기념한 새 이벤트 패스! PGC 테마 아이템을 모아보세요.',
            start: '2026-11-25T11:00:00+09:00',
            end: '2026-12-16T09:00:00+09:00'
        }, {
            id: 'home',
            type: 'offline',
            title: '펍지 유나이티드: 홈커밍',
            desc: '서울 성수 PUBG 성수에서 열리는 연말 팬 커뮤니티 페스티벌이에요.',
            start: '2026-12-18T00:00:00+09:00',
            end: '2027-01-04T23:59:00+09:00'
        }];

        const TYPES = {
            collab: {
                n: '콜라보',
                c: '#ff5c9d'
            },
            update: {
                n: '업데이트',
                c: '#52d273'
            },
            pass: {
                n: '이벤트 패스',
                c: '#ffb703'
            },
            offline: {
                n: '오프라인',
                c: '#a78bfa'
            },
            store: {
                n: '상점',
                c: '#22d3ee'
            },
            notice: {
                n: '공지',
                c: '#f87171'
            },
            tip: {
                n: '감도 팁',
                c: '#ffb703'
            }
        };

        const TIPS = [
            'DPI는 한 번 정했으면 고정하세요. 감도는 DPI가 아니라 인게임 값으로만 조절하는 게 좋아요.',
            '사격장에서 마우스를 한 바퀴(360°) 돌리는 거리를 직접 재 보세요. 눈대중보다 훨씬 정확해요.',
            '배율 감도는 한 번에 하나씩만 바꾸세요. 여러 개를 동시에 바꾸면 뭐가 좋아졌는지 알 수 없어요.',
            '4배율로 30초 정도 한 곳을 겨눠 보세요. 조준점이 흔들리면 그 배율만 감도를 낮추세요.',
            '수직 감도 배율은 1.00에서 시작하고, 반동 제어에 익숙해진 뒤 살짝 낮추는 걸 추천해요.',
            '10발·20발·30발씩 4배율로 점사해 보면서 반동 제어 느낌을 확인해 보세요.'
        ];

        /* =========================================================
           2) 알고리즘: 지금 시각 기준으로 상태 분류 + 정렬 + 슬라이드 구성
           ========================================================= */
        const status = (e, now) =>
            now < new Date(e.start) ? 'soon' : (e.end && now > new Date(e.end) ? 'end' : 'on');

        function classify(now) {
            const on = EVENTS.filter(e => status(e, now) === 'on')
                .sort((a, b) => (a.end ? +new Date(a.end) : Infinity) - (b.end ? +new Date(b.end) : Infinity)); // 끝나는 순
            const soon = EVENTS.filter(e => status(e, now) === 'soon')
                .sort((a, b) => new Date(a.start) - new Date(b.start)); // 시작하는 순
            return {
                on,
                soon
            };
        }

        function dayOfYear(d) {
            return Math.floor((d - new Date(d.getFullYear(), 0, 0)) / 86400000);
        }
        const md = d => {
            d = new Date(d);
            return (d.getMonth() + 1) + '.' + String(d.getDate()).padStart(2, '0');
        };
        const period = e => md(e.start) + ' ~ ' + (e.end ? md(e.end) : e.endText);

        function fmt(ms) {
            if (ms < 0) ms = 0;
            const s = Math.floor(ms / 1000),
                d = Math.floor(s / 86400);
            const h = String(Math.floor(s % 86400 / 3600)).padStart(2, '0');
            const m = String(Math.floor(s % 3600 / 60)).padStart(2, '0');
            const sec = String(s % 60).padStart(2, '0');
            return (d > 0 ? d + '일 ' : '') + h + ':' + m + ':' + sec;
        }

        /* 카운트다운 요소 (1초마다 갱신) */
        function cdTag(e, st) {
            if (st === 'on' && !e.end) return `<span class="cd">${e.endText}</span>`;
            const t = st === 'on' ? new Date(e.end).getTime() : new Date(e.start).getTime();
            return `<span class="cd" data-t="${t}" data-pre="${st === 'on' ? '종료까지 ' : '시작까지 '}"></span>`;
        }

        /* 슬라이드 구성: 진행 중(최대 4) → 오늘의 팁 → 예정(최대 2) */
        function buildSlides(now, {
            on,
            soon
        }) {
            const list = [];
            on.slice(0, 4).forEach(e => list.push({
                e,
                st: 'on'
            }));
            list.push({
                tip: true
            });
            soon.slice(0, 2).forEach(e => list.push({
                e,
                st: 'soon'
            }));

            return list.map(it => {
                if (it.tip) {
                    const t = TYPES.tip;
                    return `<div class="slide" style="--c:${t.c}">
          <div class="top"><span class="pill solid">오늘의 팁</span><span class="pill">${t.n}</span></div>
          <h3>이것만 기억하세요</h3>
          <p>${TIPS[dayOfYear(now) % TIPS.length]}</p>
          <a href="#calc" class="btn pri">내 감도 추천받기</a>
        </div>`;
                }
                const t = TYPES[it.e.type];
                return `<div class="slide" style="--c:${t.c}">
        <div class="top">
          <span class="pill solid">${it.st === 'on' ? '진행 중' : '예정'}</span>
          <span class="pill">${t.n}</span>
        </div>
        <h3>${it.e.title}</h3>
        <p>${it.e.desc}</p>
        <div class="meta"><span>📅 ${period(it.e)}</span>${cdTag(it.e, it.st)}</div>
      </div>`;
            });
        }

        /* 하단 목록 */
        function listHtml(arr, st) {
            if (!arr.length) return '<div class="none">해당 이벤트가 없어요.</div>';
            return arr.map(e =>
                `<div class="ev" style="--c:${TYPES[e.type].c}"><span class="nm">${e.title}</span>${cdTag(e, st)}</div>`).join('');
        }

        /* =========================================================
           3) 슬라이드 동작 (10초 자동 전환 / 호버 시 일시정지)
           ========================================================= */
        const INTERVAL = 10000;
        let slideEls = [],
            cur = 0,
            elapsed = 0,
            paused = false,
            sig = '';

        function show(i) {
            if (!slideEls.length) return;
            cur = (i + slideEls.length) % slideEls.length;
            slideEls.forEach((el, k) => el.classList.toggle('active', k === cur));
            [...$('dots').children].forEach((d, k) => d.classList.toggle('on', k === cur));
            $('count').textContent = (cur + 1) + ' / ' + slideEls.length;
            elapsed = 0;
        }

        function buildEvents() {
            const now = new Date(),
                groups = classify(now);
            const newSig = groups.on.map(e => e.id).join() + '|' + groups.soon.map(e => e.id).join();
            if (newSig === sig) return; // 상태가 안 바뀌었으면 그대로
            sig = newSig;

            $('slides').innerHTML = buildSlides(now, groups).join('');
            slideEls = [...$('slides').children];
            $('dots').innerHTML = slideEls.map((_, k) => `<i data-i="${k}"></i>`).join('');
            $('listOn').innerHTML = listHtml(groups.on, 'on');
            $('listSoon').innerHTML = listHtml(groups.soon, 'soon');
            tickCountdown();
            show(0);
        }

        function tickCountdown() {
            const now = Date.now();
            document.querySelectorAll('.cd[data-t]').forEach(el => {
                el.textContent = el.dataset.pre + fmt(+el.dataset.t - now);
            });
        }

        let last = performance.now();

        function loop(t) {
            const dt = Math.min(t - last, 200);
            last = t; // 탭이 숨겨졌다 돌아와도 튀지 않게
            if (!paused) {
                elapsed += dt;
                if (elapsed >= INTERVAL) show(cur + 1);
            }
            $('bar').style.width = (elapsed / INTERVAL * 100) + '%';
            requestAnimationFrame(loop);
        }

        $('prev').addEventListener('click', () => show(cur - 1));
        $('next').addEventListener('click', () => show(cur + 1));
        $('dots').addEventListener('click', e => {
            if (e.target.dataset.i) show(+e.target.dataset.i);
        });
        $('stage').addEventListener('mouseenter', () => paused = true);
        $('stage').addEventListener('mouseleave', () => paused = false);

        buildEvents();
        requestAnimationFrame(loop);
        setInterval(tickCountdown, 1000);
        setInterval(buildEvents, 30000); // 이벤트가 시작/종료되면 자동으로 다시 구성

        /* =========================================================
           4) 감도 추천 / 배율별 조정 / 보정
           ========================================================= */
        /* 800 DPI 기준 시작값 (여기만 고치면 추천값이 바뀝니다) */
        const GENERAL_BASE = 50; // 일반(3인칭) 감도 시작값
        const SCOPES = [{
            n: '2배율',
            b: 43
        }, {
            n: '3배율',
            b: 41
        }, {
            n: '4배율',
            b: 39
        }, {
            n: '6배율',
            b: 36
        }, {
            n: '8배율',
            b: 34
        }, {
            n: '12배율',
            b: 32
        }, {
            n: '하이브리드',
            b: 42
        }];
        let adj = SCOPES.map(() => 0); // 배율별 직접 조정값 (추천값 대비 +/-)
        let bases = [],
            vals = [];
        const clamp = v => Math.min(100, Math.max(1, Math.round(v)));
        let recText = '';

        $('grid').innerHTML = SCOPES.map((s, i) => `
    <div class="rc">
      <small>${s.n}</small>
      <strong id="rv${i}">0</strong>
      <em id="df${i}"></em>
      <input type="range" class="rg" id="rg${i}" data-i="${i}" min="1" max="100">
      <div class="pm">
        <button type="button" data-i="${i}" data-d="-1" aria-label="${s.n} 감도 내리기">−</button>
        <button type="button" data-i="${i}" data-d="1" aria-label="${s.n} 감도 올리기">+</button>
      </div>
    </div>`).join('');
        $('calBody').innerHTML = SCOPES.map((s, i) => `
    <tr><td>${s.n}</td>
      <td><input type="number" id="cur${i}" min="1" max="100"></td>
      <td><input type="number" id="mea${i}" min="1" step="0.1" placeholder="측정값"></td>
      <td><input type="number" id="tar${i}" min="1" placeholder="공통"></td>
      <td class="res" id="res${i}">-</td></tr>`).join('');

        function countTo(el, to) {
            const from = +el.textContent || 0,
                t0 = performance.now();
            (function step(t) {
                const p = Math.min((t - t0) / 450, 1);
                el.textContent = Math.round(from + (to - from) * (1 - Math.pow(1 - p, 3)));
                if (p < 1) requestAnimationFrame(step);
            })(t0);
        }

        function renderRec(animate = true) {
            const dpi = +$('dpi').value || 800,
                f = +$('style').value;
            const gen = clamp(GENERAL_BASE * (800 / dpi) * f);
            $('gsens').textContent = gen;
            $('edpi').textContent = Math.round(dpi * gen);

            SCOPES.forEach((s, i) => {
                bases[i] = clamp(s.b * (800 / dpi) * f); // 추천값
                vals[i] = clamp(bases[i] + adj[i]); // 추천값 + 내가 조정한 값
                if (animate) countTo($('rv' + i), vals[i]);
                else $('rv' + i).textContent = vals[i];
                $('rg' + i).value = vals[i];

                const diff = vals[i] - bases[i];
                $('df' + i).textContent = diff ? `추천 ${bases[i]} → ${diff > 0 ? '+' : ''}${diff}` : '추천 기본값';
                $('df' + i).classList.toggle('chg', diff !== 0);

                const c = $('cur' + i); // 보정표의 현재 감도도 같이 맞춤
                if (!c.dataset.edited) c.value = vals[i];
            });

            recText = `[SENS.LAB 배그 감도] DPI ${dpi}\n일반: ${gen}\n` +
                SCOPES.map((s, i) => `${s.n}: ${vals[i]}`).join('\n') + '\n수직 배율: 1.00';
            renderCal();
        }

        /* 배율별 직접 조정 (슬라이더 / − + 버튼) */
        function setVal(i, v) {
            adj[i] = clamp(v) - bases[i];
            renderRec(false);
        }
        $('grid').addEventListener('click', e => {
            const b = e.target.closest('button[data-d]');
            if (b) setVal(+b.dataset.i, vals[+b.dataset.i] + +b.dataset.d);
        });
        $('grid').addEventListener('input', e => {
            if (e.target.classList.contains('rg')) setVal(+e.target.dataset.i, +e.target.value);
        });
        $('resetBtn').addEventListener('click', () => {
            adj = SCOPES.map(() => 0);
            SCOPES.forEach((s, i) => delete $('cur' + i).dataset.edited);
            renderRec(true);
        });

        function renderCal() {
            const common = +$('target').value;
            SCOPES.forEach((s, i) => {
                const cur = +$('cur' + i).value,
                    mea = +$('mea' + i).value;
                const tar = +$('tar' + i).value || common;
                $('res' + i).textContent = (cur && mea && tar) ? clamp(cur * mea / tar) : '-';
            });
        }

        ['dpi', 'style'].forEach(id => $(id).addEventListener('input', renderRec));
        $('target').addEventListener('input', renderCal);
        $('calBody').addEventListener('input', e => {
            if (e.target.id.startsWith('cur')) e.target.dataset.edited = '1';
            renderCal();
        });
        $('copyBtn').addEventListener('click', () => {
            navigator.clipboard.writeText(recText).then(() => {
                $('copyBtn').textContent = '복사 완료!';
                setTimeout(() => $('copyBtn').textContent = '결과 복사', 1500);
            });
        });

        /* 스크롤 등장 효과 */
        const io = new IntersectionObserver(es => es.forEach(e => {
            if (e.isIntersecting) {
                e.target.classList.add('show');
                io.unobserve(e.target);
            }
        }), {
            threshold: 0.12
        });
        document.querySelectorAll('.reveal').forEach(el => io.observe(el));

        /* =========================================================
           5) 부드러운 화면 이동 (easing) + 현재 위치 메뉴 표시
           ========================================================= */
        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const easeInOut = t => t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; // 천천히 → 빠르게 → 천천히
        let scrollAnim = null;

        function smoothTo(y) {
            cancelAnimationFrame(scrollAnim);
            const start = window.scrollY,
                dist = y - start;
            if (reduceMotion || Math.abs(dist) < 2) {
                window.scrollTo(0, y);
                return;
            }
            const dur = Math.min(1400, 600 + Math.abs(dist) * 0.25); // 멀수록 조금 더 길게
            const t0 = performance.now();
            (function step(t) {
                const p = Math.min((t - t0) / dur, 1);
                window.scrollTo(0, start + dist * easeInOut(p));
                if (p < 1) scrollAnim = requestAnimationFrame(step);
            })(t0);
        }

        document.querySelectorAll('a[href^="#"]').forEach(a => a.addEventListener('click', e => {
            const id = a.getAttribute('href');
            const target = id.length > 1 ? document.querySelector(id) : null;
            if (id !== '#top' && !target) return;
            e.preventDefault();
            const navH = document.querySelector('nav').offsetHeight;
            const y = id === '#top' ? 0 : target.getBoundingClientRect().top + window.scrollY - navH + 20;
            smoothTo(y);
            history.replaceState(null, '', id);
        }));

        /* 사용자가 직접 스크롤하면 자동 이동 중단 */
        ['wheel', 'touchstart', 'keydown'].forEach(ev =>
            window.addEventListener(ev, () => cancelAnimationFrame(scrollAnim), {
                passive: true
            }));

        /* 지금 보고 있는 섹션을 메뉴에 표시 */
        const navLinks = [...document.querySelectorAll('nav ul a')];
        const spy = new IntersectionObserver(es => es.forEach(e => {
            if (!e.isIntersecting) return;
            navLinks.forEach(l => l.classList.toggle('active', l.getAttribute('href') === '#' + e.target.id));
        }), {
            rootMargin: '-45% 0px -50% 0px'
        });
        document.querySelectorAll('section.s').forEach(s => spy.observe(s));

        renderRec();
    </script>
</body>
</html>
